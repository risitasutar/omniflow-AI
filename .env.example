# OmniFlow AI configuration template.
# Copy this file to `.env` (which is gitignored) and fill in values locally.
# Never commit `.env`, and never paste real keys into source code or chat.

# --- Required: Google Gemini (primary LLM) -------------------------------
# Create a key at https://aistudio.google.com/apikey (free tier, no billing needed).
# GOOGLE_API_KEY is also accepted as a fallback name; GEMINI_API_KEY wins if both are set.
GEMINI_API_KEY=

# Model selection (see docs/API_KEYS_AND_SERVICES.md for why these defaults).
GEMINI_MODEL=gemini-3.8-flash
# Used automatically only on rate-limit / unavailable-model / server errors.
# Leave empty to disable the fallback.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional tuning. Leave empty to use the model's own defaults.
# GEMINI_THINKING_LEVEL=low        # low | medium | high (applies to GEMINI_MODEL only)
# GEMINI_TEMPERATURE=              # 0.0 - 2.0; Gemini 3+ recommends leaving unset
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2

# --- App limits -----------------------------------------------------------
OMNIFLOW_MAX_HISTORY_MESSAGES=40
OMNIFLOW_MAX_INPUT_CHARS=8000
OMNIFLOW_LOG_LEVEL=INFO

# --- Agent limits ---------------------------------------------------------
OMNIFLOW_MAX_TOOL_CALLS=3        # tool executions per turn
OMNIFLOW_MAX_AGENT_STEPS=8       # graph steps per turn

# --- Web search (DuckDuckGo via `ddgs`; no API key) -------------------------
OMNIFLOW_WEB_SEARCH_ENABLED=true
OMNIFLOW_WEB_SEARCH_TIMEOUT_SECONDS=10
OMNIFLOW_WEB_SEARCH_MAX_RESULTS=5

# --- Tavily research search (optional; official API, free plan, no card) ---
# Create your own key at https://app.tavily.com and put it ONLY in your local .env.
# Without it, the tavily_search tool is simply unavailable; web_search still works.
TAVILY_API_KEY=
OMNIFLOW_TAVILY_TIMEOUT_SECONDS=15
OMNIFLOW_TAVILY_MAX_RESULTS=5

# --- Weather (Open-Meteo free API; no key for non-commercial use) ----------
OMNIFLOW_WEATHER_ENABLED=true

# --- Currency (Frankfurter public API; no key; reference rates) ------------
OMNIFLOW_CURRENCY_ENABLED=true

# --- Optional: only for the original CampusX tutorial scripts -------------
# These are NOT used by OmniFlow AI.
# OPENAI_API_KEY=
# ALPHAVANTAGE_API_KEY=

# --- Documents (PDF RAG): local, free embeddings - no API key -------------
# Allowed: BAAI/bge-small-en-v1.5 (default, MIT) or sentence-transformers/all-MiniLM-L6-v2
OMNIFLOW_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Downloaded once (~67 MB) into data/models (gitignored). Set a path to move it.
# OMNIFLOW_MODEL_CACHE_DIR=
OMNIFLOW_RAG_MAX_FILES=10
OMNIFLOW_RAG_MAX_FILE_MB=20        # Streamlit also caps uploads at 25 MB
OMNIFLOW_RAG_MAX_PAGES=300
OMNIFLOW_RAG_MAX_CHUNKS=2000
OMNIFLOW_RAG_CHUNK_SIZE=1000
OMNIFLOW_RAG_CHUNK_OVERLAP=150
OMNIFLOW_RAG_TOP_K=5
OMNIFLOW_RAG_MIN_SCORE=0.55        # calibrated for bge-small; re-tune if you change models
OMNIFLOW_RAG_SESSION_TTL_MINUTES=120

# --- Optional local OCR for scanned pages (Tesseract; free, local) ----------
OMNIFLOW_OCR_ENABLED=true
# OMNIFLOW_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OMNIFLOW_OCR_MAX_PAGES=20

# --- Data analysis (CSV / XLSX; computed locally with pandas) ---------------
OMNIFLOW_DATA_MAX_FILES=5
OMNIFLOW_DATA_MAX_FILE_MB=20
OMNIFLOW_DATA_MAX_ROWS=200000
OMNIFLOW_DATA_MAX_COLUMNS=200

# --- SQLite SQL agent (read-only) ---------------------------------------------
# A synthetic SAMPLE database is generated in data/sample/ (gitignored).
OMNIFLOW_SQL_SAMPLE_ENABLED=true
# Your own database is used only when BOTH the path and the table allowlist are set.
# OMNIFLOW_SQL_DATABASE_PATH=
# OMNIFLOW_SQL_DATABASE_NAME=my_database
# OMNIFLOW_SQL_ALLOWED_TABLES=table_one,table_two
# OMNIFLOW_SQL_BLOCKED_COLUMNS=table_one.secret_column
OMNIFLOW_SQL_MAX_ROWS=200
OMNIFLOW_SQL_TIMEOUT_SECONDS=5
OMNIFLOW_SQL_IMPORT_MAX_TABLES=5     # imported tables per session (SQL page)

# --- News and academic research (keyless: DuckDuckGo News, official RSS, OpenAlex, arXiv) ---
OMNIFLOW_NEWS_ENABLED=true
OMNIFLOW_ACADEMIC_ENABLED=true
OMNIFLOW_NEWS_MAX_RESULTS=8
OMNIFLOW_ACADEMIC_MAX_RESULTS=8
OMNIFLOW_RESEARCH_TIMEOUT_SECONDS=12

# --- Saved conversations (local SQLite in the gitignored data/ folder) -------
OMNIFLOW_HISTORY_ENABLED=true
# OMNIFLOW_CONVERSATIONS_DB=data/omniflow_conversations.db
# OMNIFLOW_CHECKPOINTS_DB=data/omniflow_checkpoints.db
OMNIFLOW_HISTORY_LIST_LIMIT=50

# --- Image understanding (Gemini vision; uses GEMINI_API_KEY, no new key) ----
OMNIFLOW_IMAGES_ENABLED=true
OMNIFLOW_IMAGE_MAX_FILE_MB=10
OMNIFLOW_IMAGE_MAX_PIXELS=40000000     # decompression-bomb guard
OMNIFLOW_IMAGE_MAX_SIDE=1536           # images are downscaled to this before sending
OMNIFLOW_IMAGE_MAX_PER_CONVERSATION=6
OMNIFLOW_IMAGE_MAX_PER_CALL=3

# --- Long-term memory (preferences, project facts; local SQLite) -------------
OMNIFLOW_MEMORY_ENABLED=true
# OMNIFLOW_MEMORY_DB=data/omniflow_memory.db   # relative paths are inside the project
OMNIFLOW_MEMORY_MAX_ITEMS=8                    # memories added to one prompt
OMNIFLOW_MEMORY_MAX_CHARS=1500                 # total memory text added to one prompt

# --- Who owns saved data ----------------------------------------------------
# auto: per_session on Streamlit Community Cloud, single_user elsewhere.
# Set single_user on a hosted app ONLY if the app is private to you.
OMNIFLOW_ACCESS_MODE=auto
OMNIFLOW_SESSION_DATA_TTL_HOURS=24             # per-session data older than this is purged

# --- Coding assistant (Code page) ------------------------------------------------
OMNIFLOW_CODE_ENABLED=true
# OMNIFLOW_CODE_WORKSPACE_DIR=data/code_workspaces   # extracted uploads + patch backups
OMNIFLOW_CODE_ZIP_MAX_MB=20
OMNIFLOW_CODE_MAX_FILES=1500
OMNIFLOW_CODE_MAX_FILE_KB=256
OMNIFLOW_CODE_MAX_TOTAL_MB=12
OMNIFLOW_CODE_CHECK_TIMEOUT_SECONDS=120
# Leave these three unset for automatic: on for a private local install, off when shared.
# OMNIFLOW_CODE_LOCAL_FOLDERS_ENABLED=
# OMNIFLOW_CODE_EXECUTION_ENABLED=
# OMNIFLOW_CODE_PATCH_APPLY_ENABLED=
# Folders whose tests may run (this app's folder is always trusted). Separate with ;
# OMNIFLOW_CODE_TRUSTED_ROOTS=C:\Users\you\projects\my-app

# --- Planner (projects and tasks; local SQLite) ------------------------------------
OMNIFLOW_PLANNER_ENABLED=true
# OMNIFLOW_PLANNER_DB=data/omniflow_planner.db

# --- Data storytelling & forecasting (local pandas/NumPy) ---------------------------
OMNIFLOW_DATA_FORECAST_MAX_HORIZON=24
OMNIFLOW_DATA_MAX_SERIES_PERIODS=5000

# --- Image generation (you create these credentials yourself; see Integrations page) ---
# disabled | mock (labelled placeholder, for development) | cloudflare (free Workers AI)
# This is the ONLY setting that chooses the provider.
OMNIFLOW_IMAGE_PROVIDER=disabled
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# Chained tool steps per question (e.g. document -> planner proposal)
OMNIFLOW_MAX_TOOL_ROUNDS=3
